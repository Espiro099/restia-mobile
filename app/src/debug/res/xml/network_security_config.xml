<?xml version="1.0" encoding="utf-8"?>
<!--
    Solo en debug. Sustituye a la de release (mismo nombre de recurso).
    - 127.0.0.1 por HTTP: el backend local (php artisan serve) por adb reverse.
    - 127.0.0.1 y localhost por HTTPS: el proxy TLS local (restia-api/deploy/apache), con su certificado
      autofirmado restia_dev.crt como única CA adicional. Si se regenera el certificado, se reemplaza aquí
      y se actualiza restia.apiPins.
    Fuera de esos hosts rige lo mismo que en release.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <trust-anchors>
            <certificates src="@raw/restia_dev" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
